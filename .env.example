# =====================================================
# Crowdefik — Variables d'environnement
# Copier en .env et renseigner les valeurs
# =====================================================

# Secrets (OBLIGATOIRE en production — valeurs aléatoires longues)
CROWDEFIK_JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
CROWDEFIK_APP_SECRET=change-me-to-another-long-random-string-32chars

# Premier compte admin créé automatiquement au démarrage (si la base est vide)
CROWDEFIK_BOOTSTRAP_ADMIN_USERNAME=admin
CROWDEFIK_BOOTSTRAP_ADMIN_PASSWORD=change-me-strong-password

# CORS (laisser * si Traefik sert le frontend sur le même domaine)
CROWDEFIK_CORS_ORIGINS=*
# Activer les credentials CORS (cookies). Ne PAS utiliser avec origins=*
# CROWDEFIK_CORS_ALLOW_CREDENTIALS=false

# Mode debug : active /docs et /redoc (désactivé en prod par défaut)
# CROWDEFIK_DEBUG=false

# Niveau de log structuré JSON : DEBUG, INFO, WARNING, ERROR
# CROWDEFIK_LOG_LEVEL=INFO

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Mot de passe PostgreSQL — utilisé à la fois par le service crowdefik-db
# et par l'URL de connexion du backend.
POSTGRES_PASSWORD=change-me-strong-db-password

# ── Redis ─────────────────────────────────────────────────────────────────────
# Redis est configuré automatiquement via docker-compose (CROWDEFIK_REDIS_URL).
# Surcharger ici uniquement si vous utilisez un Redis externe.
# CROWDEFIK_REDIS_URL=redis://your-redis-host:6379/0

# ── Logs Traefik ──────────────────────────────────────────────────────────────
# Chemin vers le fichier access.log de Traefik (format JSON) dans le container.
# Permet d'enrichir les alertes WAF/AppSec avec le hostname cible (virtual host).
# Nécessite le volume mount : /_data/apps/traefik/logs:/traefik-logs:ro
# (déjà configuré dans docker-compose.yml)
CROWDEFIK_TRAEFIK_LOG_PATH=/traefik-logs/access.log
